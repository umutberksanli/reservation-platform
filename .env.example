# docker compose icin ornek. Kopyalayin:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# .env dosyasi Git'e GIRMEZ (.gitignore). Asagidaki degerleri kendi guclu degerlerinizle degistirin.

# Uygulamanin MySQL kullanicisi (reservation_app) sifresi
DB_PASSWORD=change-me-app-db-password
# MySQL root sifresi (yalnizca konteyner icinde kullanilir)
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
# JWT imza anahtari: EN AZ 32 karakter, rastgele
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Ilk admin (istege bagli; ikisi de bos birakilabilir). Sifre 8-72 karakter.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
